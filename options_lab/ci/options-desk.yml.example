# Copy to .github/workflows/options-desk.yml to enable; this template is not active.
name: Options desk checks

on:
  push:
    paths:
      - 'options_lab/**'
      - 'tests_options/**'
      - 'run_options_desk.command'
      - '.github/workflows/options-desk.yml'
  pull_request:
    paths:
      - 'options_lab/**'
      - 'tests_options/**'
      - '.github/workflows/options-desk.yml'
  workflow_dispatch:

permissions:
  contents: read

jobs:
  options-desk:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
        with:
          python-version: '3.12'
          cache: pip
          cache-dependency-path: options_lab/requirements.lock.txt
      - name: Install isolated options dependencies
        run: |
          python -m pip install -r options_lab/requirements.lock.txt
          python -m pip check
      - name: Run pricing, data, hedge and UI regressions
        run: python -m pytest tests_options -q --junitxml=options_lab_runs/ci/tests.xml
      - name: Verify original research remains unchanged
        run: |
          python - <<'PY'
          import json
          from options_lab.validate import guard_original
          result = guard_original()
          print(json.dumps(result, indent=2))
          assert result['status'] == 'passed', result
          PY
